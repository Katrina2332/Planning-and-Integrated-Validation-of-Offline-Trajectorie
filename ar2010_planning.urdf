<?xml version="1.0"?>
<!--
  Lightweight planning model for the Yaskawa Motoman AR2010 demo.
  The joint chain and limits follow the official Yaskawa ROS support model.
  Link visuals/collisions are conservative primitives; RoboDK performs the
  final validation with output/Yaskawa-Motoman-AR2010.robot.
-->
<robot name="yaskawa_motoman_ar2010">
  <material name="yaskawa_blue"><color rgba="0.08 0.24 0.72 1"/></material>

  <link name="base_link">
    <visual><origin xyz="0 0 0.2525"/><geometry><cylinder radius="0.32" length="0.505"/></geometry><material name="yaskawa_blue"/></visual>
    <collision><origin xyz="0 0 0.2525"/><geometry><cylinder radius="0.32" length="0.505"/></geometry></collision>
  </link>

  <link name="link_1">
    <visual><origin xyz="0.075 0 0"/><geometry><box size="0.34 0.42 0.36"/></geometry><material name="yaskawa_blue"/></visual>
    <collision><origin xyz="0.075 0 0"/><geometry><box size="0.34 0.42 0.36"/></geometry></collision>
  </link>
  <joint name="joint_1" type="revolute">
    <parent link="base_link"/><child link="link_1"/>
    <origin xyz="0 0 0.505" rpy="0 0 0"/><axis xyz="0 0 1"/>
    <limit lower="-3.1415926536" upper="3.1415926536" effort="3087" velocity="3.6651914292"/>
  </joint>

  <link name="link_2">
    <visual><origin xyz="0.38 0 0"/><geometry><box size="0.82 0.24 0.28"/></geometry><material name="yaskawa_blue"/></visual>
    <collision><origin xyz="0.38 0 0"/><geometry><box size="0.82 0.24 0.28"/></geometry></collision>
  </link>
  <joint name="joint_2" type="revolute">
    <parent link="link_1"/><child link="link_2"/>
    <origin xyz="0.150 0 0" rpy="1.5707963268 -1.5707963268 -3.1415926536"/><axis xyz="0 0 1"/>
    <limit lower="-1.8325957146" upper="2.7052603406" effort="3087" velocity="3.6651914292"/>
  </joint>

  <link name="link_3">
    <visual><origin xyz="0.10 -0.541 0"/><geometry><box size="0.30 1.12 0.28"/></geometry><material name="yaskawa_blue"/></visual>
    <collision><origin xyz="0.10 -0.541 0"/><geometry><box size="0.30 1.12 0.28"/></geometry></collision>
  </link>
  <joint name="joint_3" type="revolute">
    <parent link="link_2"/><child link="link_3"/>
    <origin xyz="0.760 0 0" rpy="3.1415926536 0 0"/><axis xyz="0 0 1"/>
    <limit lower="-1.5009831567" upper="2.7925268032" effort="926.1" velocity="3.8397243544"/>
  </joint>

  <link name="link_4">
    <visual><geometry><cylinder radius="0.17" length="0.34"/></geometry><material name="yaskawa_blue"/></visual>
    <collision><geometry><cylinder radius="0.17" length="0.34"/></geometry></collision>
  </link>
  <joint name="joint_4" type="revolute">
    <parent link="link_3"/><child link="link_4"/>
    <origin xyz="0.200 -1.082 0" rpy="-1.5707963268 0 0"/><axis xyz="0 0 1"/>
    <limit lower="-2.6179938780" upper="2.6179938780" effort="78.4" velocity="7.5921822462"/>
  </joint>

  <link name="link_5">
    <visual><origin xyz="0 -0.05 0"/><geometry><box size="0.20 0.26 0.20"/></geometry><material name="yaskawa_blue"/></visual>
    <collision><origin xyz="0 -0.05 0"/><geometry><box size="0.20 0.26 0.20"/></geometry></collision>
  </link>
  <joint name="joint_5" type="revolute">
    <parent link="link_4"/><child link="link_5"/>
    <origin xyz="0 0 0" rpy="1.5707963268 0 0"/><axis xyz="0 0 1"/>
    <limit lower="-2.3561944902" upper="1.5707963268" effort="67.03" velocity="7.5921822462"/>
  </joint>

  <link name="link_6">
    <visual><geometry><cylinder radius="0.12" length="0.20"/></geometry><material name="yaskawa_blue"/></visual>
    <collision><geometry><cylinder radius="0.12" length="0.20"/></geometry></collision>
  </link>
  <joint name="joint_6" type="revolute">
    <parent link="link_5"/><child link="link_6"/>
    <origin xyz="0 -0.100 0" rpy="-1.5707963268 0 0"/><axis xyz="0 0 1"/>
    <limit lower="-3.6651914292" upper="3.6651914292" effort="33.3" velocity="12.2173047639"/>
  </joint>

  <link name="flange"/>
  <joint name="joint_6-flange" type="fixed">
    <parent link="link_6"/><child link="flange"/>
    <origin xyz="0 0 0" rpy="0 1.5707963268 0"/>
  </joint>

  <link name="tool0"/>
  <joint name="flange-tool0" type="fixed">
    <parent link="flange"/><child link="tool0"/>
    <origin xyz="0 0 0" rpy="3.1415926536 -1.5707963268 0"/>
  </joint>
</robot>
