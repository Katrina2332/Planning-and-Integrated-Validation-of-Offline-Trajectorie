      <material name="step_blue"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.210"/>
      <geometry><box size="0.16 0.16 0.420"/></geometry>
    </collision>
  </link>
  <joint name="joint_2" type="revolute">
    <parent link="shoulder_link"/><child link="upper_arm_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-6.2831853072" upper="6.2831853072" effort="0" velocity="3.1415926536"/>
  </joint>

  <link name="forearm_link">
    <visual>
      <origin xyz="0 0 0.184"/>
      <geometry><box size="0.145 0.145 0.368"/></geometry>
      <material name="step_blue"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.184"/>
      <geometry><box size="0.145 0.145 0.368"/></geometry>
    </collision>
  </link>
  <joint name="joint_3" type="revolute">
    <parent link="upper_arm_link"/><child link="forearm_link"/>
    <origin xyz="0 0 0.420" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-6.2831853072" upper="6.2831853072" effort="0" velocity="3.1415926536"/>
  </joint>

  <link name="wrist_1_link">
    <visual>
      <origin xyz="0 0 0.056"/>
      <geometry><cylinder radius="0.078" length="0.112"/></geometry>
      <material name="joint_dark"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.056"/>
      <geometry><cylinder radius="0.078" length="0.112"/></geometry>
    </collision>
  </link>
  <joint name="joint_4" type="revolute">
    <parent link="forearm_link"/><child link="wrist_1_link"/>
    <origin xyz="0 0 0.368" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-6.2831853072" upper="6.2831853072" effort="0" velocity="3.1415926536"/>
  </joint>

  <link name="wrist_2_link">
    <visual><geometry><sphere radius="0.075"/></geometry><material name="step_blue"/></visual>
    <collision><geometry><sphere radius="0.075"/></geometry></collision>
  </link>
  <joint name="joint_5" type="revolute">
    <parent link="wrist_1_link"/><child link="wrist_2_link"/>
    <origin xyz="0 0 0.112" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-6.2831853072" upper="6.2831853072" effort="0" velocity="3.1415926536"/>
  </joint>

  <link name="wrist_3_link">
    <visual>
      <origin xyz="-0.0475 0 0" rpy="0 -1.5707963268 0"/>
      <geometry><cylinder radius="0.060" length="0.095"/></geometry>
      <material name="joint_dark"/>
    </visual>
    <collision>
      <origin xyz="-0.0475 0 0" rpy="0 -1.5707963268 0"/>
