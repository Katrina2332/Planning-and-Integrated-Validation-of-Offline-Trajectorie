<?xml version="1.0"?>
<robot name="step_scr5_provisional">
  <material name="step_blue"><color rgba="0.05 0.28 0.68 1"/></material>
  <material name="joint_dark"><color rgba="0.16 0.18 0.22 1"/></material>

  <link name="base_link">
    <visual>
      <origin xyz="0 0 0.08075"/>
      <geometry><cylinder radius="0.105" length="0.1615"/></geometry>
      <material name="joint_dark"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.08075"/>
      <geometry><cylinder radius="0.105" length="0.1615"/></geometry>
    </collision>
  </link>

  <link name="shoulder_link">
    <visual><geometry><sphere radius="0.105"/></geometry><material name="step_blue"/></visual>
    <collision><geometry><sphere radius="0.105"/></geometry></collision>
  </link>
  <joint name="joint_1" type="revolute">
    <parent link="base_link"/><child link="shoulder_link"/>
    <origin xyz="0 0 0.1615" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-6.2831853072" upper="6.2831853072" effort="0" velocity="3.1415926536"/>
  </joint>

  <link name="upper_arm_link">
    <visual>
      <origin xyz="0 0 0.210"/>
